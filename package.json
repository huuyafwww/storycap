{
  "name": "storycapture-root",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/huuyafwww/storycapture#readme",
  "bugs": {
    "url": "https://github.com/huuyafwww/storycapture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huuyafwww/storycapture.git"
  },
  "license": "MIT",
  "author": "tsuyoshiwada",
  "contributors": [
    "Yosuke Kurami"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --parallel && yarn doc && yarn copy:misc",
    "build:pages": "yarn typedoc:build",
    "clean": "turbo run clean && pnpm run clean:self",
    "clean:self": "rimraf node_modules .turbo",
    "copy:misc": "yarn copy:misc:storycapture",
    "copy:misc:storycapture": "cpy README.md CONTRIBUTING.md MIGRATION.md LICENSE packages/storycapture",
    "deploy:ci": "lerna run clean && yarn build && lerna publish --yes from-package --dist-tag \"$(node ./scripts/get-dist-tag.js)\"",
    "deploy:manual": "lerna run clean && yarn build && lerna publish",
    "deploy:pages": "gh-pages -d dist-pages -m \"[ci skip]\"",
    "doc": "yarn doc:clihelp && yarn doc:toc",
    "doc:clihelp": "node scripts/cli-help.js",
    "doc:toc": "node scripts/add-toc.js",
    "e2e": "bash e2e.sh",
    "linkall": "lerna exec --parallel yarn link",
    "lint": "pnpm run lint:code && pnpm run lint:type",
    "lint:code": "eslint . --cache && turbo lint:code",
    "lint:type": "turbo lint:type",
    "regression": "reg-suit run",
    "sort:package": "sort-package-json 'package.json' 'packages/*/package.json'",
    "test": "lerna run test",
    "typedoc:build": "lerna run typedoc",
    "unlinkall": "lerna exec --parallel --bail=false yarn unlink"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@huuyafwww/eslint-config-yaml": "^1.0.0",
    "@huuyafwww/tsconfig-common": "^1.1.3",
    "@praha/eslint-config-definer": "^2.0.1",
    "copy-dir": "1.3.0",
    "cpy": "8.1.2",
    "cpy-cli": "5.0.0",
    "eslint": "^9.32.0",
    "gh-pages": "6.3.0",
    "jiti": "^2.5.1",
    "lefthook": "^1.12.2",
    "lerna": "4.0.0",
    "markdown-toc": "1.2.0",
    "pretty-quick": "4.0.0",
    "reg-keygen-git-hash-plugin": "0.14.3",
    "reg-notify-github-plugin": "0.14.3",
    "reg-publish-s3-plugin": "0.14.3",
    "reg-suit": "0.14.3",
    "rimraf": "^6.0.1",
    "sort-package-json": "^2.15.1",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.9.0"
}
