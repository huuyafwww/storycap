{
  "name": "storyscanner",
  "version": "9.0.0",
  "description": "Utilities to build Storybook crawling tools with Puppeteer",
  "keywords": [
    "storybook",
    "puppeteer",
    "chrome"
  ],
  "homepage": "https://github.com/huuyafwww/storycapture/packages/storyscanner",
  "bugs": {
    "url": "https://github.com/huuyafwww/storycapture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huuyafwww/storycapture.git"
  },
  "license": "MIT",
  "author": "tsuyoshiwada",
  "contributors": [
    "Yosuke Kurami"
  ],
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "pkgroll --minify",
    "build:watch": "pkgroll --watch",
    "clean": "rimraf node_modules dist .turbo lib \"*.tsbuildinfo\"",
    "lint:code": "eslint . --cache",
    "lint:code:fix": "eslint . --cache --fix",
    "lint:type": "tsc --pretty --noEmit",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "dependencies": {
    "chalk": "^5.5.0",
    "puppeteer-core": "^24.16.0",
    "wait-on": "^8.0.4"
  },
  "devDependencies": {
    "@huuyafwww/eslint-config-common": "^1.3.0",
    "@huuyafwww/eslint-config-javascript": "^1.0.1",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/eslint-config-typescript": "^1.0.1",
    "@types/node": "^24.2.0",
    "@types/wait-on": "^5.3.4",
    "pkgroll": "^2.15.3",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
