{
  "name": "storyscanner",
  "version": "9.0.0",
  "description": "Utilities to build Storybook crawling tools with Puppeteer",
  "keywords": [
    "storybook",
    "puppeteer",
    "chrome"
  ],
  "homepage": "https://github.com/huuyafwww/storycapture/packages/storyscanner",
  "bugs": {
    "url": "https://github.com/huuyafwww/storycapture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huuyafwww/storycapture.git"
  },
  "license": "MIT",
  "author": "tsuyoshiwada",
  "contributors": [
    "Yosuke Kurami"
  ],
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typings": "lib/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "pkgroll --minify",
    "build:watch": "pkgroll --watch",
    "clean": "rimraf node_modules dist .turbo lib \"*.tsbuildinfo\"",
    "jest": "jest",
    "lint:code": "eslint . --cache",
    "lint:code:fix": "eslint . --cache --fix",
    "lint:type": "tsc --pretty --noEmit",
    "test": "npm run jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testMatch": [
      "**/__tests__/*.(ts|tsx)",
      "**/*.test.(ts|tsx)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "_old/.*",
      "examples/.*",
      "\\.d\\.ts$",
      "lib/.*"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    }
  },
  "dependencies": {
    "chalk": "^2.4.1",
    "puppeteer-core": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "devDependencies": {
    "@huuyafwww/eslint-config-common": "^1.3.0",
    "@huuyafwww/eslint-config-javascript": "^1.0.0",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/eslint-config-typescript": "^1.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.2.0",
    "@types/wait-on": "^5.0.0",
    "jest": "29.7.0",
    "pkgroll": "^2.15.3",
    "ts-jest": "29.2.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
