{
  "name": "storycapture",
  "version": "10.0.0",
  "description": "A Storybook addon, Save the screenshot image of your stories! via puppeteer.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./register": {
      "types": "./lib/client/register.d.ts",
      "import": "./lib/client/register.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./lib/client/register.js"
  ],
  "typings": "lib/index.d.ts",
  "bin": {
    "storycapture": "lib/node/cli.js"
  },
  "scripts": {
    "clean": "rimraf -g lib \"*.tsbuildinfo\"",
    "build": "tsc --p tsconfig.build.json",
    "prepare": "yarn clean && yarn build",
    "test": "vitest run",
    "typedoc": "typedoc --out \"../../dist-pages/typedoc/storycapture\" --ignoreCompilerErrors --tsconfig tsconfig.build.json src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huuyafwww/storycapture.git"
  },
  "author": "tsuyoshiwada",
  "contributors": [
    "Yosuke Kurami"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/huuyafwww/storycapture/issues"
  },
  "homepage": "https://github.com/huuyafwww/storycapture#readme",
  "files": [
    "lib",
    "assets",
    "CONTRIBUTING.md",
    "MIGRATION.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "storybook",
    "addon",
    "puppeteer",
    "chrome",
    "screenshot",
    "capture",
    "visual-testing",
    "storybook-addon",
    "testing",
    "test"
  ],
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "@types/mkdirp": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/wait-on": "^5.0.0",
    "@types/yargs": "^17.0.0",
    "minimist": "1.2.8",
    "puppeteer": "23.11.1",
    "storybook": "^10.0.0",
    "typedoc": "0.27.6",
    "typescript": "5.7.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "mkdirp": "^3.0.0",
    "micromatch": "^4.0.8",
    "puppeteer-core": "^9.0.0",
    "rimraf": "^6.0.0",
    "sanitize-filename": "^1.6.3",
    "storycrawler": "^5.0.1",
    "yargs": "^17.0.0"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  }
}
