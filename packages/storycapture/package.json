{
  "name": "storycapture",
  "version": "9.0.0",
  "description": "A Storybook addon, Save the screenshot image of your stories! via puppeteer.",
  "keywords": [
    "storybook",
    "addon",
    "puppeteer",
    "chrome",
    "screenshot",
    "capture",
    "visual-testing",
    "storybook-addon",
    "testing",
    "test"
  ],
  "homepage": "https://github.com/huuyafwww/storycapture#readme",
  "bugs": {
    "url": "https://github.com/huuyafwww/storycapture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huuyafwww/storycapture.git"
  },
  "license": "MIT",
  "author": "tsuyoshiwada",
  "contributors": [
    "Yosuke Kurami"
  ],
  "sideEffects": [
    "./register.js",
    "./lib/client/register.js",
    "./lib-esm/client/register.js"
  ],
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typings": "lib/index.d.ts",
  "bin": {
    "storycapture": "lib/node/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "CONTRIBUTING.md",
    "MIGRATION.md",
    "README.md",
    "LICENSE",
    "package.json",
    "register.js"
  ],
  "scripts": {
    "build": "pkgroll --minify",
    "build:watch": "pkgroll --watch",
    "clean": "rimraf node_modules dist .turbo lib lib-esm \"*.tsbuildinfo\"",
    "lint:code": "eslint . --cache",
    "lint:code:fix": "eslint . --cache --fix",
    "lint:type": "tsc --pretty --noEmit",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "dependencies": {
    "mkdirp": "^3.0.0",
    "nanomatch": "^1.2.13",
    "puppeteer-core": "^24.16.0",
    "sanitize-filename": "^1.6.3",
    "storyscanner": "workspace:*",
    "yargs": "^17.0.0"
  },
  "devDependencies": {
    "@huuyafwww/eslint-config-common": "^1.3.0",
    "@huuyafwww/eslint-config-javascript": "^1.0.0",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/eslint-config-typescript": "^1.0.0",
    "@types/mkdirp": "^2.0.0",
    "@types/node": "^24.2.0",
    "@types/wait-on": "^5.3.4",
    "@types/yargs": "^17.0.0",
    "minimist": "1.2.8",
    "pkgroll": "^2.15.3",
    "puppeteer": "23.11.1",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "storybook": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
