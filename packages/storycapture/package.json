{
  "name": "storycapture",
  "version": "9.0.0",
  "description": "A Storybook addon, Save the screenshot image of your stories! via puppeteer.",
  "keywords": [
    "storybook",
    "addon",
    "puppeteer",
    "chrome",
    "screenshot",
    "capture",
    "visual-testing",
    "storybook-addon",
    "testing",
    "test"
  ],
  "homepage": "https://github.com/huuyafwww/storycapture#readme",
  "bugs": {
    "url": "https://github.com/huuyafwww/storycapture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huuyafwww/storycapture.git"
  },
  "license": "MIT",
  "author": "tsuyoshiwada",
  "contributors": [
    "Yosuke Kurami"
  ],
  "sideEffects": [
    "./register.js",
    "./lib/client/register.js",
    "./lib-esm/client/register.js"
  ],
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typings": "lib/index.d.ts",
  "bin": {
    "storycapture": "lib/node/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "CONTRIBUTING.md",
    "MIGRATION.md",
    "README.md",
    "LICENSE",
    "package.json",
    "register.js"
  ],
  "scripts": {
    "build": "pkgroll --minify",
    "build:watch": "pkgroll --watch",
    "clean": "rimraf node_modules dist .turbo lib lib-esm \"*.tsbuildinfo\"",
    "lint:code": "eslint . --cache",
    "lint:code:fix": "eslint . --cache --fix",
    "lint:type": "tsc --pretty --noEmit",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "testMatch": [
      "**/__tests__/*.(ts|tsx)",
      "**/*.test.(ts|tsx)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "_old/.*",
      "examples/.*",
      "\\.d\\.ts$",
      "lib/.*"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    }
  },
  "dependencies": {
    "mkdirp": "^3.0.0",
    "nanomatch": "^1.2.13",
    "puppeteer-core": "^9.0.0",
    "sanitize-filename": "^1.6.3",
    "storycrawler": "^5.0.1",
    "yargs": "^17.0.0"
  },
  "devDependencies": {
    "@huuyafwww/eslint-config-common": "^1.3.0",
    "@huuyafwww/eslint-config-javascript": "^1.0.0",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/eslint-config-typescript": "^1.0.0",
    "@types/jest": "29.5.14",
    "@types/mkdirp": "^2.0.0",
    "@types/node": "^24.2.0",
    "@types/wait-on": "^5.0.0",
    "@types/yargs": "^17.0.0",
    "jest": "29.7.0",
    "minimist": "1.2.8",
    "pkgroll": "^2.15.3",
    "puppeteer": "23.11.1",
    "ts-jest": "29.2.5",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "storybook": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
