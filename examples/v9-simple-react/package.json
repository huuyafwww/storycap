{
  "name": "v9-simple-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "react-scripts build",
    "build-storybook": "storybook build --test",
    "clean": "rimraf node_modules dist .turbo __screenshots__",
    "eject": "react-scripts eject",
    "lint:code": "eslint . --cache",
    "lint:code:fix": "eslint . --cache --fix",
    "lint:type": "tsc --pretty --noEmit",
    "start": "react-scripts start",
    "prestorybook": "../../scripts/e2e-prestorybook.js .",
    "storybook": "storybook dev -p 9009",
    "storycapture:all": "pnpm prestorybook && storycapture --verbose --serverTimeout 100000 --serverCmd \"storybook dev -p 9009\" \"http://localhost:9009\"",
    "test": "react-scripts test --setupFiles ./setupFile.js"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.0"
  },
  "devDependencies": {
    "@huuyafwww/eslint-config-common": "^1.3.0",
    "@huuyafwww/eslint-config-javascript": "^1.0.0",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/eslint-config-typescript": "^1.0.0",
    "@storybook/addon-links": "^9.1.1",
    "@storybook/cli": "^9.1.1",
    "@storybook/preset-create-react-app": "^9.1.1",
    "@storybook/react": "^9.1.1",
    "@storybook/react-webpack5": "^9.1.1",
    "@testing-library/react": "^14.0.0",
    "storybook": "^9.1.1",
    "typescript": "^5.9.2"
  }
}
