    "@storybook/react-vite": "^10.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "jsdom": "^24.0.0",
    "prop-types": "^15.8.1",
    "rimraf": "^5.0.0",
    "storybook": "^10.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
