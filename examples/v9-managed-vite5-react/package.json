{
  "name": "v9-managed-vite5-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build --test",
    "clean": "rimraf node_modules dist .turbo __screenshots__",
    "dev": "vite",
    "lint:code": "eslint . --cache",
    "lint:code:fix": "eslint . --cache --fix",
    "lint:type": "tsc --pretty --noEmit",
    "preview": "vite preview",
    "prestorybook": "../../scripts/e2e-prestorybook.js .",
    "storybook": "storybook dev -p 6006",
    "storycapture:all": "pnpm prestorybook && storycapture --verbose --serverTimeout 100000 --serverCmd \"storybook dev -p 9009\" \"http://localhost:9009\"",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.2.23",
    "@huuyafwww/eslint-config-common": "^1.3.0",
    "@huuyafwww/eslint-config-javascript": "^1.0.0",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/eslint-config-typescript": "^1.0.0",
    "@storybook/addon-docs": "^9.1.1",
    "@storybook/addon-links": "^9.1.1",
    "@storybook/addon-onboarding": "^9.1.1",
    "@storybook/react": "^9.1.1",
    "@storybook/react-vite": "^9.1.1",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "http-server": "^14.1.1",
    "jsdom": "^24.0.0",
    "prop-types": "^15.8.1",
    "storybook": "^9.1.1",
    "typescript": "^5.9.2",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
