{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@huuyafwww/tsconfig-react",
  ],
  "compilerOptions": {
    "types": [
      "@types/node",
      "vitest/globals"
    ]
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "**/*.ts",
    "**/*.tsx",
  ],
  "exclude": [
    "node_modules",
  ]
}
